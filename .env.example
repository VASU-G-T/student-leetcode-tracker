# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional GitHub Token (for higher API rate limits up to 5,000 req/hr)
# Note: For public deployment, keep sync calls on backend/serverless functions if using private PATs.
VITE_GITHUB_TOKEN=

# Default settings
VITE_APP_NAME="LeetTrack"
VITE_DEFAULT_GOAL=200
VITE_AUTO_SYNC_INTERVAL_MINUTES=15
